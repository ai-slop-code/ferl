# Local development only. Replace both secrets before any non-local deployment.
FERL_DATABASE_URL=postgres://ferl:ferl@127.0.0.1:55432/ferl_test
FERL_PUBLIC_BASE_URL=https://links.example.test/
FERL_CURSOR_KEY=replace_with_generated_43_character_base64url_key
FERL_LISTEN_ADDR=127.0.0.1:8080
FERL_HTTP_MAX_IN_FLIGHT=256
FERL_HTTP_MAX_WAITING=256

# Optional local settings; defaults are documented in docs/configuration.md.
FERL_ANONYMOUS_CREATION=false
FERL_ANONYMOUS_CREATE_LIMIT=5
FERL_ACCOUNT_CREATE_LIMIT=60
FERL_CREATION_TIMEOUT_SECS=15
FERL_LINK_OPERATION_TIMEOUT_SECS=30
FERL_REPORT_OPERATION_TIMEOUT_SECS=30
FERL_TRUSTED_PROXIES=
FERL_ANALYTICS_QUEUE_CAPACITY=2048
FERL_ANALYTICS_WORKERS=4
FERL_ANALYTICS_RETRY_BUDGET=3
FERL_ANALYTICS_OPERATION_TIMEOUT_SECS=30
FERL_ANALYTICS_ROLLBACK_TIMEOUT_SECS=2
FERL_ANALYTICS_DRAIN_TIMEOUT_SECS=5
